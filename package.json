{
  "name": "quiz-game",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/shared",
    "packages/server",
    "packages/client"
  ],
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev -w @quiz/server",
    "dev:client": "npm run dev -w @quiz/client",
    "build": "npm run build -w @quiz/client",
    "start": "npm run start -w @quiz/server",
    "questions:import": "npm run questions:import -w @quiz/server",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "oxfmt .",
    "lint": "oxlint --type-aware && oxfmt --check .",
    "lint:fix": "oxlint --type-aware --fix && oxfmt ."
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "oxc-transform-react": "^0.156.0",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=26"
  }
}
