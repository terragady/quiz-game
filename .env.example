# Port the server listens on. Defaults to 3000 locally.
# On Render this is provided automatically — do not set it there.
PORT=3000

# Comma-separated list of origins allowed to connect over Socket.IO.
# Leave unset to reflect any origin (fine when the client is served from the
# same origin as the server, as in production). Set it to lock down cross-origin
# access, e.g. CLIENT_ORIGIN=https://quiz.example.com
# CLIENT_ORIGIN=
